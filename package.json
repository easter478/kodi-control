{
  "name": "kodi-control",
  "version": "1.0.0",
  "description": "Manage a Kodi box over SSH: stats, skin tweaks, OSD, logs, backups",
  "main": "app/main.js",
  "scripts": {
    "app": "electron .",
    "predist": "node scripts/stamp.js",
    "dist": "electron-builder --win portable",
    "test": "node test/run.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "productName": "Kodi Control",
  "build": {
    "appId": "com.local.kodicontrol",
    "productName": "Kodi Control",
    "files": ["app/**/*", "package.json"],
    "win": { "target": "portable", "icon": "build/icon.ico" },
    "portable": { "artifactName": "KodiControl.exe" },
    "directories": { "output": "release" }
  },
  "dependencies": { "ssh2": "^1.17.0" },
  "devDependencies": { "electron": "^44.8.0", "electron-builder": "^26.15.3" }
}
